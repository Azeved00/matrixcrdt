        <mxCell id="-Wv2Q-0P7uw55c062ff6-26" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;State&lt;/h1&gt;&lt;div&gt;All clients and replicas know this piece of state.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="aDYkH86SO8wR03iJJXfE-1" vertex="1">
          <mxGeometry x="910" y="70" width="210" height="130" as="geometry" />
