        </mxCell>
        <mxCell id="svMoqzFHZ02drXgd6kxN-3" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Unique Linearization of the DAG&lt;/h1&gt;&lt;div&gt;Because all of the nodes have unique identifiers (their hashes), then a unique linearization can be achived by doing a lexicographic sort of the parents and traversing the, by that order&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=1;strokeColor=default;spacing=10;" parent="1" vertex="1">
          <mxGeometry x="1891" y="320" width="360" height="190" as="geometry" />
