        <mxCell id="-Wv2Q-0P7uw55c062ff6-27" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Operations And their order&lt;/h1&gt;&lt;div&gt;&amp;nbsp;Q&lt;sub&gt;i&amp;nbsp; &lt;/sub&gt;Query operation,&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;A&lt;/span&gt;&lt;sub style=&quot;background-color: initial;&quot;&gt;i&lt;/sub&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;,Apply operation and M&lt;/span&gt;&lt;sub style=&quot;background-color: initial;&quot;&gt;i &lt;/sub&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;,&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Merge operation&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Order: A&lt;sub style=&quot;background-color: initial;&quot;&gt;1&amp;nbsp;&lt;/sub&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&amp;nbsp;- A&lt;/span&gt;&lt;sub style=&quot;background-color: initial;&quot;&gt;2&lt;/sub&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&amp;nbsp;- M&lt;/span&gt;&lt;sub style=&quot;background-color: initial;&quot;&gt;1 &lt;/sub&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;- M&lt;/span&gt;&lt;sub style=&quot;background-color: initial;&quot;&gt;2&amp;nbsp;&lt;/sub&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;- Q&lt;/span&gt;&lt;sub style=&quot;background-color: initial;&quot;&gt;1&lt;/sub&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&amp;nbsp;- Q&lt;/span&gt;&lt;span style=&quot;background-color: initial; font-size: 10px;&quot;&gt;&lt;sub&gt;2&lt;/sub&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial; font-size: 10px;&quot;&gt;&lt;sub&gt;&lt;br&gt;&lt;/sub&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;A&lt;sub&gt;1&lt;/sub&gt;&amp;nbsp;adds node S&lt;sub&gt;5&lt;/sub&gt;&amp;nbsp;(with S&lt;sub&gt;4&lt;/sub&gt;&amp;nbsp;as a parent) to the State DAG.&lt;/div&gt;&lt;div&gt;A&lt;span style=&quot;font-size: 10px;&quot;&gt;&