        <mxCell id="CZrcFLLcgDB98Wi20-BA-115" value="&lt;div&gt;&lt;ol style=&quot;line-height: 170%;&quot;&gt;&lt;li&gt;The Client, with state G&lt;sub&gt;c&lt;/sub&gt;, makes a query to replica i, to which the replica answers with G&lt;sub&gt;s&lt;/sub&gt;.&lt;/li&gt;&lt;li&gt;G&lt;sub&gt;c&lt;/sub&gt; is sub-graph of G&lt;sub&gt;s&lt;/sub&gt;.&lt;/li&gt;&lt;li&gt;Client will verify G&lt;sub&gt;s&lt;/sub&gt; recursively, upon reaching any node that is already known S&lt;sub&gt;1&lt;/sub&gt;,...,S&lt;sub&gt;5&lt;/sub&gt; we do not need to verify.&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="610" y="90" width="240" height="240" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
