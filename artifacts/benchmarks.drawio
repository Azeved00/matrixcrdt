        <mxCell id="fmqIz3d7NAKczvJLAuY0-4" value="This is done by read/write locks as the dag is shared between all threads" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;" parent="1" vertex="1">
          <mxGeometry x="450" y="855" width="120" height="80" as="geometry" />
        </mxCell>
        <mxCell id="fmqIz3d7NAKczvJLAuY0-5" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Benchmarking the DAG&lt;/h1&gt;&lt;p&gt;Benchmarks are done by measuring the time an operation on the dag takes (updating or querying), the time will start counting after a thread acquires the lock (write for updating, read for querying) and stop counting when the operation finishes.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="900" y="90" width="375" height="120" as="geometry" />
        </mxCell>
        <mxCell id="9IzVuyE3F7Zcb7mbEnKR-1" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;How Benchmarking will work&lt;/span&gt;&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;2 frontends doing independent operations on the backend. The backend will keep a file for each frontend (thread) in wich it will save the time it took for those operations.&lt;/span&gt;&lt;/h1&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px; font-weight: 400;&quot;&gt;This benchmark will be repeated abount 1000 times, the average times will be calculated and plotted&amp;nbsp;&lt;/span&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="910" y="330" width="430" height="230" as="geometry" />
        </mxCell>
      </root>
